# Local development against the Firebase emulators (npm run emulators). No real project needed.
VITE_USE_EMULATORS=true
VITE_FB_API_KEY=demo-key
VITE_FB_AUTH_DOMAIN=demo-wine-cellar.firebaseapp.com
VITE_FB_PROJECT_ID=demo-wine-cellar
VITE_FB_STORAGE_BUCKET=demo-wine-cellar.appspot.com
VITE_FB_MESSAGING_SENDER_ID=0
VITE_FB_APP_ID=demo-app
