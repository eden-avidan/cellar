# Loaded only by the local emulator. AI_MOCK=true returns a canned wine instead of calling Claude,
# so the app can be tried locally without an API key. Delete this line (and put your key in
# functions/.secret.local as ANTHROPIC_API_KEY=...) to test against the real API locally.
AI_MOCK=true

# Required param; the emulator skips the allow-list check, so any placeholder works locally.
ALLOWED_EMAILS=local@example.com
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
